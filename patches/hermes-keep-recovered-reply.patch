+def _keep_plugin_recovered_refusal(agent, result: Any) -> None:
+    """model-router patch (option B): when a ``transform_llm_output`` plugin replaced a
+    content-policy refusal with a recovered reply, keep the turn as a normal completed turn
+    (user row + tool rounds + the recovered assistant reply) instead of erasing it. Clearing
+    ``failure_reason`` stops every owner (TUI/Desktop, CLI, ACP, gateway) from rewinding it.
+    Trade-off: the refused request stays in model context and may re-trip the filter later."""
+    if not isinstance(result, dict):
+        return
+    turn_messages = result.pop("_refused_turn_messages", None)
+    if result.get("failure_reason") != "content_policy_blocked" or not result.get("response_transformed"):
+        return
+    reply = result.get("final_response")
+    if not isinstance(turn_messages, list) or not isinstance(reply, str) or not reply.strip():
+        return
+    try:
+        messages = list(turn_messages)
+        append_message(messages, {"role": "assistant", "content": reply})
+        agent._flush_messages_to_session_db(messages)
+    except Exception:
+        logger.warning("model-router patch: could not keep the recovered reply", exc_info=True)
+        return
+    for key in ("failed", "error", "failure_reason", "failure_retryable", "refused_turn_boundary_row_id"):
+        result.pop(key, None)
+    result.update(messages=messages, completed=True)
+
+
